{
  "manifest_version": 3,
  "name": "CoachKtool Draft Sync",
  "version": "1.0.3",
  "description": "Sync League Champion Select picks to Coach K's drafting page.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [],
  "browser_specific_settings": {
    "gecko": {
      "id": "{5d07fd1e-114f-4711-a1b1-b0a4b3fe89bc}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "matches": [
        "https://coachkarakal.com/drafting*",
        "https://www.coachkarakal.com/drafting*"
      ]
    }
  ]
}
